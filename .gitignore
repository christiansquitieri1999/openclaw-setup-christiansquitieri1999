# Secret-bearing local config files
.openclaw/openclaw.json
.openclaw/openclaw.json.bak
.openclaw/openclaw.json.bak.*
.openclaw/openclaw.json.bak-*
.openclaw/openclaw.json.clobbered.*
.openclaw/openclaw.json.last-good
.openclaw/secrets/
.openclaw/agents/main/agent/plugins/litellm/catalog.json

# OpenClaw credentials and sensitive logs/snapshots
.openclaw/credentials/*.json
.openclaw/logs/config-audit.jsonl
.openclaw/cache/shell-snapshots/*.sh

# Conversation/session artifacts may contain pasted secrets
.openclaw/agents/main/sessions/

# OAuth and API credentials
.mcporter/credentials.json

# Shell history can contain pasted tokens
.bash_history

# OpenClaw runtime/state noise
.openclaw/agents/main/agent/*.sqlite
.openclaw/agents/main/agent/*.sqlite-*
.openclaw/state/*.sqlite
.openclaw/state/*.sqlite-*
.openclaw/tui/last-session.json
.openclaw/workspace-attestations/*.attested
.openclaw/completions/
.openclaw/workspace/.clawhub/
.openclaw/workspace/memory/
.openclaw/workspace/openclaw-workspace-state.json

# Local machine noise
.wget-hsts
.lesshst
.copilot/**
.log_execution/**
.npm/**
.ssh/**
.vscode-server/**
snap/**
.cache/copilot/
.config/Code/
.dotnet/

# 4Geeks student token - MAI committare
.4geeks_token
*.token

# Dati locali OpenClaw non pubblici
.openclaw/devices/
.openclaw/media/
.openclaw/workspace/config/

# Cache Python
__pycache__/
*.pyc
